PORT=4000
MODE=development
FRONTEND_URL=http://localhost:5173

# Option 1: Local MongoDB
# MONGO_URL=mongodb://localhost:27017/EduVerse

# Option 2: MongoDB Atlas (cloud) — apna cluster banake "Connect > Drivers" se string copy karo
# <password> ko apne DB user ke password se replace karo (special chars ho to URL-encode karo)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/EduVerse?retryWrites=true&w=majority

JWT_SECRET=secretKey
