PORT=4000
MODE=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas (cloud) — local MongoDB install/run karne ki zaroorat nahi.
# Atlas Dashboard → apna cluster → "Connect" → "Drivers" se connection string copy karo.
# IMPORTANT: apne current IP ko whitelist karna na bhoolein:
#   Dashboard → Security → Network Access → ADD IP ADDRESS → "Allow Access From Anywhere" (0.0.0.0/0)
# <username>/<password> ko apne DB user ke credentials se replace karo
# (password me special chars ho to URL-encode karo)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/EduVerse?retryWrites=true&w=majority

JWT_SECRET=secretKey

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
ADMIN_NAME=EduVerse Admin

# AI provider (OpenAI-compatible). Google Gemini ke liye neeche diye values use karo.
# Groq:      AI_BASE_URL=https://api.groq.com/openai/v1
#             AI_MODEL=llama-3.3-70b-versatile
# Gemini:    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#             AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash
